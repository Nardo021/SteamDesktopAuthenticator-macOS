<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.EncryptionPasswordWindow"
        Title="Encryption password"
        Width="400"
        Height="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Encryption password" />
        <TextBox x:Name="PasswordBox" PasswordChar="*" />
        <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" MinHeight="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Unlock" MinWidth="88" IsDefault="True" Click="OnUnlockClick" />
        </StackPanel>
    </StackPanel>
</Window>
