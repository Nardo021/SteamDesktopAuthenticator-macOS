<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.EncryptionPasswordWindow"
        Classes="sdaDialog"
        Title="Encryption passkey"
        Width="400"
        MinHeight="180">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Encryption passkey" />
        <TextBox x:Name="PasswordBox"
                 PasswordChar="*"
                 AutomationProperties.Name="Encryption passkey" />
        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource SdaErrorBrush}"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   MinHeight="20"
                   AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Unlock" MinWidth="88" IsDefault="True" Click="OnUnlockClick" />
        </StackPanel>
    </StackPanel>
</Window>
