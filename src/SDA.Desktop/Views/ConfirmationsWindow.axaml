<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SDA.Desktop.Views"
        x:Class="SDA.Desktop.Views.ConfirmationsWindow"
        Title="{Binding Title}"
        Width="480"
        Height="640"
        MinWidth="400"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <views:ByteArrayImageConverter x:Key="ByteArrayImage" />
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16" Spacing="8">
            <Button Content="{Binding RefreshButtonText}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding CanRefresh}"
                    Click="OnRefreshClick" />
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       LineHeight="21"
                       MinHeight="20"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Confirmations}" Margin="16,0,16,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SdaImageOutline}"
                                BoxShadow="0 1 4 0 #40000000"
                                CornerRadius="16">
                            <Grid ColumnDefinitions="68,*">
                                <Border Width="60"
                                        Height="60"
                                        CornerRadius="16"
                                        ClipToBounds="True"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SdaImageOutline}"
                                        IsVisible="{Binding HasIcon}">
                                    <Image Width="60"
                                           Height="60"
                                           Stretch="Uniform"
                                           Source="{Binding IconBytes, Converter={StaticResource ByteArrayImage}}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="21" />
                                    <TextBlock Text="{Binding CreatorText}" TextWrapping="Wrap" LineHeight="21" />
                                    <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" LineHeight="21" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button Content="{Binding AcceptLabel}"
                                                MinWidth="88"
                                                IsEnabled="{Binding CanAct}"
                                                Click="OnAcceptClick" />
                                        <Button Content="{Binding CancelLabel}"
                                                MinWidth="88"
                                                IsEnabled="{Binding CanAct}"
                                                Click="OnCancelClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
