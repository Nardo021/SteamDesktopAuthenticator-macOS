<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.DeactivateConfirmCodeWindow"
        Title="Deactivate Authenticator"
        Width="460"
        Height="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBlock Text="Enter this confirmation code:" />
        <TextBox x:Name="CodeDisplay" IsReadOnly="True" FontFamily="Menlo, Consolas, monospace" FontSize="22" />
        <TextBox x:Name="CodeBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Confirm" MinWidth="88" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
