<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.EncryptionManagementWindow"
        Classes="sdaDialog"
        Title="{Binding Title}"
        Width="460"
        MinHeight="280">
    <StackPanel Margin="20" Spacing="10">
        <StackPanel Spacing="10" IsVisible="{Binding IsManage}">
            <TextBlock Text="Current passkey" />
            <TextBox x:Name="CurrentBox"
                     PasswordChar="*"
                     AutomationProperties.Name="Current passkey" />
        </StackPanel>
        <TextBlock Text="New passkey" />
        <TextBox x:Name="NewBox"
                 PasswordChar="*"
                 AutomationProperties.Name="New passkey" />
        <TextBlock Text="Confirm new passkey" />
        <TextBox x:Name="ConfirmBox"
                 PasswordChar="*"
                 AutomationProperties.Name="Confirm new passkey" />
        <TextBlock Text="{Binding NewKeyHint}" TextWrapping="Wrap" LineHeight="21" />
        <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   MinHeight="24"
                   Foreground="{DynamicResource SdaErrorBrush}"
                   AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Continue" MinWidth="88" IsDefault="True" IsEnabled="{Binding CanSubmit}" Click="OnContinueClick" />
        </StackPanel>
    </StackPanel>
</Window>
