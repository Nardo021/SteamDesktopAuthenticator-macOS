<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.MainWindow"
        Title="Steam Desktop Authenticator"
        Width="440"
        Height="560"
        MinWidth="360"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">
    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Text="Account" FontWeight="SemiBold" />
        <TextBox x:Name="AccountSearchBox"
                 Grid.Row="1"
                 Margin="0,8,0,8"
                 PlaceholderText="account name"
                 AutomationProperties.Name="Search accounts"
                 Text="{Binding SearchText, Mode=TwoWay}" />
        <ComboBox Grid.Row="2"
                  Margin="0,8,0,16"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Accounts}"
                  SelectedItem="{Binding SelectedAccount}"
                  PlaceholderText="No accounts yet"
                  AutomationProperties.Name="Account">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Row="3" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Steam Guard Code" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding CurrentCode}"
                       FontSize="42"
                       FontWeight="SemiBold"
                       FontFamily="Menlo, Consolas, monospace"
                       HorizontalAlignment="Center"
                       AutomationProperties.Name="Steam Guard Code">
                <TextBlock.FontFeatures>
                    <FontFeature Tag="tnum" />
                </TextBlock.FontFeatures>
            </TextBlock>
            <TextBlock Text="{Binding CountdownText}"
                       FontFamily="Menlo, Consolas, monospace"
                       HorizontalAlignment="Center"
                       AutomationProperties.Name="Code countdown">
                <TextBlock.FontFeatures>
                    <FontFeature Tag="tnum" />
                </TextBlock.FontFeatures>
            </TextBlock>
            <Button Content="Copy Code"
                    MinWidth="160"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding CanCopyCode}"
                    Click="OnCopyClick" />
        </StackPanel>

        <Button Grid.Row="4"
                Content="Open maFiles Folder"
                HorizontalAlignment="Stretch"
                Margin="0,24,0,28"
                Click="OnOpenFolderClick" />
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
            <TextBlock Text="Status" FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Content="{Binding VersionLabel}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,2"
                    FontSize="11"
                    Opacity="0.65"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Check for updates"
                    Click="OnVersionClick" />
        </Grid>
        <TextBlock Grid.Row="6"
                   Margin="0,6,0,0"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
