<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.SmsCodeWindow"
        Classes="sdaDialog"
        Title="SMS Code"
        Width="420"
        MinHeight="180">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="PromptText"
                   Text="Enter the SMS code sent to your phone."
                   TextWrapping="Wrap"
                   LineHeight="21" />
        <TextBox x:Name="CodeBox" AutomationProperties.Name="SMS code" />
        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource SdaErrorBrush}"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   MinHeight="20"
                   AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancelClick" />
            <Button Content="Submit" MinWidth="88" IsDefault="True" Click="OnSubmitClick" />
        </StackPanel>
    </StackPanel>
</Window>
