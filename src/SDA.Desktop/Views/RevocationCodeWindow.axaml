<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SDA.Desktop.Views.RevocationCodeWindow"
        Classes="sdaDialog"
        Title="Revocation Code"
        Width="460"
        MinHeight="220">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" LineHeight="21" FontWeight="SemiBold" />
        <TextBox x:Name="CodeBox"
                 IsReadOnly="True"
                 FontFamily="Menlo, Consolas, monospace"
                 FontSize="22"
                 AutomationProperties.Name="Revocation code" />
        <TextBlock Text="You may need it to recover or remove the authenticator."
                   TextWrapping="Wrap"
                   LineHeight="21" />
        <TextBlock x:Name="ConfirmPrompt"
                   IsVisible="False"
                   Text="Enter the revocation code you just saved:"
                   TextWrapping="Wrap"
                   LineHeight="21" />
        <TextBox x:Name="ConfirmBox"
                 IsVisible="False"
                 AutomationProperties.Name="Confirm revocation code" />
        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource SdaErrorBrush}"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   MinHeight="20"
                   AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" IsVisible="False" Click="OnCancelClick" />
            <Button x:Name="ContinueButton" Content="Continue" MinWidth="88" IsDefault="True" Click="OnContinueClick" />
        </StackPanel>
    </StackPanel>
</Window>
