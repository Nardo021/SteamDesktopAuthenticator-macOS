<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SDA.Desktop.App"
             Name="Steam Desktop Authenticator"
             RequestedThemeVariant="Default">
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Steam Desktop Authenticator" Click="OnAboutClick" />
            <NativeMenuItem Header="Check for Updates..." Click="OnCheckUpdatesClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Settings..." Gesture="Meta+Comma" Click="OnSettingsClick" />
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SdaErrorBrush">#B00020</SolidColorBrush>
                    <SolidColorBrush x:Key="SdaImageOutline">#6B6B6B</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SdaErrorBrush">#FF8A80</SolidColorBrush>
                    <SolidColorBrush x:Key="SdaImageOutline">#9A9A9A</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window.sdaDialog">
            <Setter Property="SizeToContent" Value="Height" />
            <Setter Property="MaxHeight" Value="720" />
            <Setter Property="CanResize" Value="True" />
            <Setter Property="WindowStartupLocation" Value="CenterOwner" />
        </Style>
    </Application.Styles>
    <!-- TrayIcon is created once in App.axaml.cs so the NativeMenu can be rebuilt when accounts change.
         TrayIcon.Clicked is intentionally unused: macOS opens the native menu instead. -->
</Application>
